# VPM Packaging Exclusions
# Infrastructure / CI
.git/
.github/
.DS_Store

# Build artifacts & binaries
dist/
bin/
*.app/
*.exe
*.so
*.dylib
*.dll
*.db
build_app
build_demos
list_windows

# Development-only directories (not needed in installed module)
# Excluding these prevents VLS/v-analyzer from picking up `module main`
# demo files, which cause struct name conflicts and break code completion.
demos/
examples/
tests/
scripts/
tools/
docs/
screenshots/
resources/
